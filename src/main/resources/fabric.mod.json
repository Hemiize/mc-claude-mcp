{
	"schemaVersion": 1,
	"id": "claudemcp",
	"version": "${version}",
	"name": "Claude MCP",
	"contact": { "homepage": "https://github.com/Hemiize/mc-claude-mcp", "sources": "https://github.com/Hemiize/mc-claude-mcp" },
	"description": "Lets Claude Code control the Minecraft client through an embedded MCP server (state, actions, tasks, memory, reflection, Groovy scripts).",
	"authors": ["Hemiize"],
	"license": "Apache-2.0",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.leon.claudemcp.ClaudeMcp"]
	},
	"mixins": ["claudemcp.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.165.0"
	}
}
